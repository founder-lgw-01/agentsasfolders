---
import Base from '../../layouts/Base.astro'
import { getCollection } from 'astro:content'

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
)

const fmt = (d) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  })
---

<Base
  title="Blog"
  description="Writing on ICM, Hermes, and building systems your agent can actually use."
  path="/blog"
>
  <section>
    <div class="wrap">
      <span class="badge">Blog</span>
      <h1>Writing</h1>
      <p class="lede">
        ICM, Hermes, and systems your agent can actually use.
      </p>

      {posts.length === 0 && (
        <p style="color:var(--muted);margin-top:2rem">
          Nothing published yet. The first post is being written.
        </p>
      )}

      <div style="margin-top:3rem;display:grid;gap:1.25rem">
        {posts.map((post) => (
          <a
            href={`/blog/${post.slug}/`}
            class="card"
            style="text-decoration:none;display:block"
          >
            <p
              style="color:var(--muted);font-size:0.8rem;margin:0 0 0.5rem;font-family:var(--mono)"
            >
              {fmt(post.data.date)}
            </p>
            <h2 style="font-size:1.35rem;margin:0 0 0.5rem;color:var(--text)">
              {post.data.title}
            </h2>
            <p style="color:var(--muted);margin:0">{post.data.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
