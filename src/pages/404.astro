---
import Base from '../layouts/Base.astro'
---

<Base
  title="Not here"
  description="That page does not exist."
  path="/404"
>
  <section>
    <div class="wrap prose">
      <span class="badge">404</span>
      <h1>Nothing in this folder</h1>
      <p class="lede">
        That page does not exist, or it moved. Fitting, given the subject.
      </p>
      <div class="btn-row">
        <a class="btn" href="/">Back to the front</a>
        <a class="btn btn--ghost" href="/start">Build 3 folders</a>
      </div>
    </div>
  </section>
</Base>
