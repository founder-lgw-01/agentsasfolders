---
import { LINKS } from '../config'
const { id = 'waitlist' } = Astro.props
---

<form class="form-row" id={id} method="POST" action={LINKS.waitlistApi}>
  <label class="sr-only" for={`${id}-email`}>Email address</label>
  <input
    id={`${id}-email`}
    type="email"
    name="email"
    placeholder="you@yourbusiness.com"
    required
    autocomplete="email"
  />
  <input type="hidden" name="source" value={Astro.url.pathname} />
  <button class="btn" type="submit">Tell me when it opens</button>
</form>
<p class="form-msg" id={`${id}-msg`} role="status" aria-live="polite"></p>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script define:vars={{ id }}>
  const form = document.getElementById(id)
  const msg = document.getElementById(`${id}-msg`)

  if (form) {
    const btn = form.querySelector('button')
    // Never write through a null node: if the message element is missing the
    // button must still come back, or the form is dead until a reload.
    const say = (text) => {
      if (msg) msg.textContent = text
    }
    let busy = false

    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      // Guards the double submit that a disabled button alone does not catch:
      // Enter pressed twice, or any programmatic submit.
      if (busy) return
      busy = true

      try {
        if (btn) btn.disabled = true
        say('Adding you...')

        const res = await fetch(form.action, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        })
        const data = await res.json().catch(() => ({}))

        if (res.ok) {
          say(data.message || "You're on the list.")
          form.reset()
        } else {
          say(data.message || 'That did not work. Try again.')
        }
      } catch {
        say('Network trouble. Try again in a minute.')
      } finally {
        // Runs even if something above threw, so the button always returns.
        busy = false
        if (btn) btn.disabled = false
      }
    })
  }
</script>
