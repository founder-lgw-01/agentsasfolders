---
import { LINKS } from '../config'
const { id = 'waitlist' } = Astro.props
---

<form class="form-row" id={id} method="POST" action={LINKS.waitlistApi}>
  <label class="sr-only" for={`${id}-email`}>Email address</label>
  <input
    id={`${id}-email`}
    type="email"
    name="email"
    placeholder="you@yourbusiness.com"
    required
    autocomplete="email"
  />
  <input type="hidden" name="source" value={Astro.url.pathname} />
  <button class="btn" type="submit">Tell me when it opens</button>
</form>
<p class="form-msg" id={`${id}-msg`} role="status" aria-live="polite"></p>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script define:vars={{ id }}>
  const form = document.getElementById(id)
  const msg = document.getElementById(`${id}-msg`)

  form?.addEventListener('submit', async (e) => {
    e.preventDefault()
    const btn = form.querySelector('button')
    btn.disabled = true
    msg.textContent = 'Adding you...'

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      })
      const data = await res.json().catch(() => ({}))

      if (res.ok) {
        msg.textContent = data.message || "You're on the list."
        form.reset()
      } else {
        msg.textContent = data.message || 'That did not work. Try again.'
      }
    } catch {
      msg.textContent = 'Network trouble. Try again in a minute.'
    } finally {
      btn.disabled = false
    }
  })
</script>
